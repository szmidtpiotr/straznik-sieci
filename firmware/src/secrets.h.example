// Dane dostępowe strażnika. Skopiuj ten plik do secrets.h i wpisz swoje wartości:
//
//   cp src/secrets.h.example src/secrets.h
//
// secrets.h jest w .gitignore — nie trafia do repozytorium. Uwaga: zbudowany
// obraz .bin zawiera te hasła, więc też go nikomu nie wysyłaj.
//
// To są wartości na pierwszy start. Wszystko poza dwoma hasłami z sekcji
// „OBOWIĄZKOWE” można potem zmienić w panelu WWW (zapis w pamięci urządzenia
// ma pierwszeństwo przed tym plikiem). Szczegóły: docs/02-instalacja.md.

#pragma once

// ---------- OBOWIĄZKOWE (bez nich firmware się nie zbuduje) ----------

// Hasło do panelu WWW i do wgrywania aktualizacji. Login zawsze: admin
#define PANEL_PASS         ""

// Hasło awaryjnej sieci Wi-Fi „Straznik-Setup” (min. 8 znaków). Strażnik wystawia
// ją, gdy przez minutę nie może połączyć się z Twoim Wi-Fi.
#define SETUP_AP_PASS      ""

// ---------- OPCJONALNE (można zostawić puste i ustawić w panelu) ----------

// Twoja sieć Wi-Fi (tylko 2,4 GHz — ESP32 nie widzi 5 GHz).
#define DEFAULT_WIFI_SSID  ""
#define DEFAULT_WIFI_PASS  ""

// Bot Telegram (token od @BotFather) i numer czatu. Czat najwygodniej ustawić
// w panelu przyciskiem „To mój czat”. Puste = alarmy tylko w dzienniku panelu.
#define DEFAULT_TG_TOKEN   ""
#define DEFAULT_TG_CHAT    ""

// Home Assistant przez MQTT. Pusty adres = MQTT wyłączone. docs/04-home-assistant.md
#define DEFAULT_MQTT_HOST  ""
#define DEFAULT_MQTT_USER  "straznik"
#define DEFAULT_MQTT_PASS  ""

// IPMI (zdalne zarządzanie serwerem) do awaryjnego restartu. Tylko konto
// z uprawnieniem OPERATOR. Pusty adres = funkcja wyłączona. docs/05-restart-serwera-ipmi.md
#define DEFAULT_IPMI_HOST  ""
#define DEFAULT_IPMI_USER  "straznik"
#define DEFAULT_IPMI_PASS  ""
